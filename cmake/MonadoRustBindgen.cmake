#.rst:
# MonadoRustBindgen
# -----------------
#
# Generates bindgen/monado-sys.txt in the build directory. This allows
# Rust bindgen to match exactly the CMake arguments of the build, to
# ensure the generated bindings match what is actually linked against.
#
# When ``MONADO_RUST_CARGO_CONFIG`` is on, this also generates
# ``.cargo/config.toml`` in the source directory so tools such as
# rust-analyzer and IDEs are able to build the rust workspace.

option(MONADO_RUST_CARGO_CONFIG
       "Write .cargo/config.toml in the source tree so IDEs' cargo uses this build's bindgen arguments"
       ON
       )

function(_monado_defines_from_flags out flags)
	separate_arguments(flags UNIX_COMMAND "${flags}")
	list(FILTER flags INCLUDE REGEX "^-[DU]")
	list(JOIN flags "\n" flags)
	set(${out}
	    "${flags}"
	    PARENT_SCOPE
	    )
endfunction()

function(monado_rust_bindgen_args)
	set(includes "$<REMOVE_DUPLICATES:$<TARGET_PROPERTY:monado_rust-static,INTERFACE_INCLUDE_DIRECTORIES>>")
	set(defines "$<TARGET_PROPERTY:monado_rust-static,INTERFACE_COMPILE_DEFINITIONS>")

	_monado_defines_from_flags(flags "${CMAKE_C_FLAGS}")
	if(CMAKE_CONFIGURATION_TYPES)
		set(configs ${CMAKE_CONFIGURATION_TYPES})
		set(suffix "-$<CONFIG>")
		# Config used by cargo when run outside cmake (e.g. by the IDE)
		list(GET configs 0 ide_config)
		set(ide_suffix "-${ide_config}")
	else()
		set(configs ${CMAKE_BUILD_TYPE})
		set(suffix "")
		set(ide_suffix "")
	endif()
	foreach(config IN LISTS configs)
		string(TOUPPER "${config}" config_upper)
		_monado_defines_from_flags(config_flags "${CMAKE_C_FLAGS_${config_upper}}")
		string(APPEND flags "\n$<$<CONFIG:${config}>:${config_flags}>")
	endforeach()

	set(args_base "${CMAKE_BINARY_DIR}/bindgen/monado-sys")
	file(
		GENERATE
		OUTPUT "${args_base}${suffix}.txt"
		CONTENT
			"-I$<JOIN:${includes},\n-I>
$<$<BOOL:${defines}>:-D$<JOIN:${defines},\n-D>>
${flags}
"
		)
	corrosion_set_env_vars(monado_rust "MONADO_BINDGEN_ARGS=${args_base}${suffix}.txt")

	if(MONADO_RUST_CARGO_CONFIG)
		file(
			CONFIGURE
			OUTPUT "${PROJECT_SOURCE_DIR}/.cargo/config.toml"
			CONTENT
				"# Generated by ${CMAKE_CURRENT_FUNCTION_LIST_FILE} for the build in
# ${CMAKE_BINARY_DIR}. Set MONADO_RUST_CARGO_CONFIG=OFF to disable
[env]
MONADO_BINDGEN_ARGS = '${args_base}${ide_suffix}.txt'
"
			)
	endif()
endfunction()
